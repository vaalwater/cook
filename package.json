{
  "name": "cook-recipe-collector",
  "version": "1.0.0",
  "private": true,
  "description": "下厨房菜谱合集半自动抓取 + 本地菜谱库（搜索/排序）",
  "main": "src/server.js",
  "scripts": {
    "login": "node --no-warnings src/scraper/login.js",
    "scrape": "node --no-warnings src/scraper/scrape.js",
    "fetch-images": "node --no-warnings src/scraper/fetch-images.js",
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.49.1"
  }
}
